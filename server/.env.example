# Server Environment Variables
GNANI_API_KEY_ID=your_gnani_api_key_here        # legacy name, used if GNANI_API_KEY absent
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_API_KEY=your_gnani_api_key_here
GNANI_ACCESS_TOKEN=                              # optional bearer token
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET_NAME=audiobook
PORT=4001
NODE_ENV=development          # development | production
# Comma-separated browser origins allowed to call this API. MUST be set on every
# deploy (e.g. https://app.vercel.app,https://preview.app.vercel.app).
FRONTEND_URL=http://localhost:5175
# Extra opt-in required on top of NODE_ENV=development to serve unauthenticated
# requests as the mock user. Never set in production.
ALLOW_DEV_MOCK_USER=false

# TTS Provider Selection
TTS_PROVIDER=gtts                    # gnani | gtts (gtts = free local fallback)
TTS_FALLBACK_ENABLED=true              # gnani→gtts fallback on network/5xx only (4xx fails hard)

# Async Queue (optional — falls back to in-memory if absent)
REDIS_URL=                           # redis://localhost:6379

# Groq (LLM Director, genre classifier, transcript normalizer)
GROQ_API_KEY=your_groq_key_here
GROQ_DIRECTOR_MODEL=                 # default qwen/qwen3.8-27b
GROQ_CLASSIFIER_MODEL=               # default qwen/qwen3.8-27b
GROQ_NORMALIZER_MODEL=               # default qwen/qwen3.8-27b — verify the model exists for this key

# DEV ONLY — forces credit deduction to succeed so UI testing is never blocked. Never set in production.
# DEV_BYPASS_CREDITS=true