# Server Environment Variables
GNANI_API_KEY_ID=your_gnani_api_key_here
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET_NAME=audiobook
PORT=4001
FRONTEND_URL=http://localhost:5175

# TTS Provider Selection
TTS_PROVIDER=gtts                    # gnani | gtts (gtts = free local fallback)
GTTS_FALLBACK_ENABLED=true           # auto-fallback to gtts if gnani request fails

# Async Queue (optional — falls back to in-memory if absent)
REDIS_URL=                           # redis://localhost:6379