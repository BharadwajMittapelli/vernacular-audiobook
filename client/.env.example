# Client Environment Variables - Template
# Set these in Vercel project settings

# Supabase Configuration (find in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://znhhavbeqxoydojywttu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL (Railway deployment URL or localhost for development)
